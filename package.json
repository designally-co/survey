{
  "name": "designally-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "db:reset": "rm -rf .pglite && npm run db:migrate && npm run db:seed",
    "db:inspect": "node --env-file-if-exists=.env.local --import tsx scripts/inspect.ts",
    "dev:backdate": "node --env-file-if-exists=.env.local --import tsx scripts/dev-backdate.ts",
    "dev:fixture": "node --env-file-if-exists=.env.local --import tsx scripts/dev-fixture.ts",
    "dev:analyse": "node --env-file-if-exists=.env.local --require ./scripts/no-server-only.cjs --import tsx scripts/dev-analyse.ts",
    "db:clear": "node --env-file-if-exists=.env.local --import tsx scripts/clear-mock-data.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@electric-sql/pglite": "^0.5.4",
    "@types/qrcode": "^1.5.6",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}
